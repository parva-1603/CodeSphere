# Backend Environment Variables
PORT=5000
MONGODB_URI=mongodb://localhost:27017/codesphere

# Firebase Admin Configuration
# To get this, go to Firebase Console -> Project Settings -> Service Accounts -> Generate New Private Key
FIREBASE_PROJECT_ID=codesphere-b7acd
FIREBASE_CLIENT_EMAIL=your-service-account-email@codesphere-b7acd.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# GitHub App Configuration
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
